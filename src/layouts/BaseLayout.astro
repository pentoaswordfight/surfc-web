---
/**
 * BaseLayout — shared <head> and <body> chrome for every marketing page.
 *
 * Responsibilities:
 *   - Meta tags (SEO, viewport, theme, OG, Twitter)
 *   - Font preconnect + Google Fonts (matches the app's current load)
 *   - Klaro consent banner (SUR-620, src/scripts/consent.ts) — PostHog
 *     loads only after an explicit "allow"
 *   - Canonical URL derived from the requested path
 *
 * Port sources:
 *   - surfc/index.html — meta tags, fonts
 *   - SUR-218 plan — OG image + Twitter card requirements
 */

import '@braird/tokens/css'
import '../styles/fonts.css'
import '../styles/marketing.css'
// SUR-679 — Braird front door + chrome flip. Loaded LAST so its forest
// chrome overrides win over marketing.css's parchment defaults.
import '../styles/braird.css'

interface Props {
  title?:       string
  description?: string
  ogImage?:     string
  path?:        string
  noindex?:     boolean
  nofollow?:    boolean
  bodyClass?:   string
  /**
   * Body-level data attributes. Keys are emitted as `data-${key}` and must
   * already be kebab-case (e.g. `'blog-slug'` → `data-blog-slug`). Browsers
   * normalise camelCase to lowercase, breaking `dataset.blogSlug` reads,
   * so the normalisation must happen at the call site.
   */
  bodyData?:    Record<string, string | number>
}

const {
  title       = 'Marginborn — a personal index of great ideas',
  description = "Marginborn turns a lifetime of reading into something you can actually think with. Capture printed passages and handwritten notes; tag them to 97 canonical ideas or your own.",
  ogImage     = '/marginborn-og-primary.png',
  path        = Astro.url.pathname,
  noindex     = false,
  nofollow    = false,
  bodyClass   = 'lp-page-v2',
  bodyData    = {},
} = Astro.props

const robotsParts: string[] = []
if (noindex)  robotsParts.push('noindex')
if (nofollow) robotsParts.push('nofollow')
const robotsContent = robotsParts.join(', ')

const canonical = new URL(path, Astro.site ?? 'https://marginborn.com').toString()
const ogImageUrl = new URL(ogImage, Astro.site ?? 'https://marginborn.com').toString()

---

<!doctype html>
<!-- data-theme pinned to "light": @braird/tokens ships a dark theme (system + manual),
     but the marketing site isn't dark-audited yet, so OS dark is gated here (the emitted
     @media block targets :root:not([data-theme="light"])). Remove to enable dark. SUR-642. -->
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#15281C" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {robotsContent && <meta name="robots" content={robotsContent} />}

    <title>{title}</title>

    <!-- Favicons -->
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/icon-192.png" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Marginborn" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@marginborn" />
    <meta name="twitter:creator" content="@marginborn" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- Fonts: self-hosted via @fontsource/* (see src/styles/fonts.css).
         font-display:optional suppresses CLS — no swap shift on load. -->

    <!-- PostHog itself loads from src/scripts/consent.ts, and only after the
         visitor allows analytics (SUR-620). Before that window.posthog is
         undefined and this listener no-ops. -->
    <script is:inline>
      // Global CTA-click attribution. Fires on capture phase so the event is
      // queued before the browser navigates away. SUR-367 adds an additive
      // `marketing_signup_clicked` capture for every signup-intent CTA so
      // the new conversion funnel anchors on a single step-1 event without
      // disturbing existing dashboards built on `app_cta_clicked`.
      //
      // The listener always registers — the body guards on `window.posthog`,
      // so it no-ops until consent loads PostHog, and Playwright can install a
      // recorder onto window.posthog to exercise the contract.
      //
      // Pricing-page CTAs are included: `pricing_start_free` and
      // `pricing_hero_start_free` are direct signup intents, and
      // `pricing_get_pro_annual` requires account creation before
      // checkout (cold visitors hit UpgradeAuthGate first), so it
      // anchors the same signup funnel.
      var SIGNUP_CTAS = {
        nav_signup:              1,
        hero_signup:             1,
        closing_signup:          1,
        pricing_start_free:      1,
        pricing_hero_start_free: 1,
        pricing_get_pro_annual:  1,
      };
      document.addEventListener('click', function (event) {
        var target = event.target && event.target.closest ? event.target.closest('[data-cta]') : null;
        if (!target || !window.posthog) return;
        var cta = target.getAttribute('data-cta');
        window.posthog.capture('app_cta_clicked', { cta: cta });
        if (Object.prototype.hasOwnProperty.call(SIGNUP_CTAS, cta)) {
          window.posthog.capture('marketing_signup_clicked', { cta: cta });
        }
      }, true);
    </script>

    <!-- Per-page extras (Article JSON-LD on blog posts, etc.) -->
    <slot name="head" />
  </head>
  <body class={bodyClass} {...Object.fromEntries(Object.entries(bodyData).map(([k, v]) => [`data-${k}`, String(v)]))}>
    <slot />

    <!-- SUR-370 — Forward UTM / click-ID params from the marketing page's
         URL onto cross-domain `app.braird.app` CTAs so AuthScreen's
         `auth_landing_viewed` event carries campaign attribution. -->
    <script>
      import '../scripts/preserveUtm'
    </script>

    <!-- SUR-620 — consent banner; [data-consent-open] (footer link) re-opens it. -->
    <script>
      import { startConsent, showConsentPreferences } from '../scripts/consent'
      startConsent()
      document.querySelector('[data-consent-open]')?.addEventListener('click', (event) => {
        showConsentPreferences(event.currentTarget as HTMLElement)
      })
    </script>
  </body>
</html>
