---
/**
 * /testwithus/ — Android closed-testing sign-up (SUR-1200). Play needs at
 * least 12 testers opted in for 14 days (SUR-702); this page recruits them and
 * is linked from the SUR-1065 announcement and social posts.
 *
 * The form POSTs to the `tester-signup` Edge Function in surfc/ via
 * `src/scripts/testerSignupForm.ts`. Field names, the honeypot and the consent
 * statement are a cross-repo contract with that function: the consent label
 * below is quoted verbatim into every sign-up mail as the consent record, so
 * change it there too (`CONSENT_STATEMENT`). Nothing is mailed to the visitor;
 * the founder replies with the Play opt-in link once their Google account is
 * on the tester list.
 *
 * Design: the forest front-door ground, with the form as a paper page whose
 * labels sit in its margin — the one bold element. `noindex` and out of the
 * sitemap: a campaign page that retires when closed testing ends.
 */
import BaseLayout from '../layouts/BaseLayout.astro'
import Nav from '../components/Nav.astro'
import Footer from '../components/Footer.astro'
import '../styles/policy.css'
---

<BaseLayout
  title="Test the Android app — Marginborn"
  description="Help test the Marginborn Android app before it opens on Google Play. Sign up with your Google account and use the app for 14 days."
  path="/testwithus/"
  noindex
  bodyClass="braird-front-door"
>
  <Nav />
  <main class="tw bf-dots">
    <div class="bf-wrap tw-grid">
      <div class="tw-copy">
        <h1 class="tw-title">Help us test Marginborn on Android.</h1>
        <p class="tw-lede">
          Before a new app can go on Google Play, Google asks for at least 12 people to test it
          for 14 days. Sign up here and we’ll send you the link to join.
        </p>
      </div>

      <div class="tw-sheet">
        <noscript>
          <p class="policy-note">
            This form needs JavaScript. You can email
            <a href="mailto:hello@marginborn.com">hello@marginborn.com</a> instead — tell us the
            Google account you use on Google Play, and we’ll add you.
          </p>
        </noscript>

        <p id="tw-status" class="policy-status" role="status" tabindex="-1" hidden></p>
        <p id="tw-alert" class="policy-alert" role="alert" tabindex="-1" hidden></p>

        <!-- method="post": if the script has not loaded yet, a submit must never put the email in a URL. -->
        <form id="tw-form" class="policy-form tw-form" method="post" novalidate aria-label="Sign up to test Marginborn">
          <!-- Phone first: it decides what the email field asks for. -->
          <div class="tw-row">
            <span id="tw-phone-label" class="tw-label">Your phone</span>
            <div class="tw-field" role="radiogroup" aria-labelledby="tw-phone-label" aria-describedby="tw-phone-hint" aria-required="true">
              <div class="policy-choices tw-phones">
                <label><input type="radio" name="phone" value="android" required /> <span>Android</span></label>
                <label><input type="radio" name="phone" value="ios" /> <span>iPhone</span></label>
              </div>
              <p id="tw-phone-hint" class="policy-hint">The app is Android-only for now. Choose iPhone and we’ll email you when it’s ready.</p>
            </div>
          </div>

          <div class="tw-row">
            <label for="tw-email" class="tw-label">Google account email</label>
            <div class="tw-field">
              <input id="tw-email" name="email" type="email" class="inp" required maxlength="254" autocomplete="email" aria-describedby="tw-email-hint" />
              <p id="tw-email-hint" class="policy-hint">The one you use on Google Play — we can only invite that account. On iPhone, any email works.</p>
            </div>
          </div>

          <div class="tw-row">
            <label for="tw-device" class="tw-label">Phone model <span class="policy-optional">(optional)</span></label>
            <div class="tw-field">
              <input id="tw-device" name="device" type="text" class="inp" maxlength="120" autocomplete="off" placeholder="Pixel 8, Galaxy S24" />
            </div>
          </div>

          <div class="tw-row">
            <label for="tw-produce" class="tw-label">What do you write or produce? <span class="policy-optional">(optional)</span></label>
            <div class="tw-field">
              <input id="tw-produce" name="produce" type="text" class="inp" maxlength="200" autocomplete="off" aria-describedby="tw-produce-hint" />
              <p id="tw-produce-hint" class="policy-hint">For example: essays, a newsletter, research, client reports.</p>
            </div>
          </div>

          <div class="tw-row">
            <div class="tw-field">
              <div class="policy-choices">
                <label><input id="tw-consent" type="checkbox" name="consent" required aria-describedby="tw-consent-hint" /> <span>I agree that Marginborn may use these details to contact me about testing the app, including follow-up research, and, if I chose iPhone, to tell me when the iPhone app is ready. I can withdraw at any time.</span></label>
              </div>
              <p id="tw-consent-hint" class="policy-hint">To withdraw, email <a href="mailto:hello@marginborn.com">hello@marginborn.com</a>. How we handle your data: <a href="/policies/privacy/">Privacy Policy</a>.</p>
            </div>
          </div>

          <!-- Honeypot: humans never see it; a filled value is dropped silently server-side. -->
          <div class="policy-trap" aria-hidden="true">
            <label for="tw-hp">Leave this field empty</label>
            <input id="tw-hp" name="hp_trap" type="text" tabindex="-1" autocomplete="off" />
          </div>

          <div class="tw-row">
            <div class="tw-field">
              <button type="submit" class="bf-cta tw-submit">Sign up to test</button>
            </div>
          </div>
        </form>
      </div>

      <section class="tw-next" aria-labelledby="tw-next-title">
        <h2 id="tw-next-title" class="tw-next-title">What happens next</h2>
        <ol class="tw-steps">
          <li>We add your Google account to the test and email you a link.</li>
          <li>You open the link on your phone and install Marginborn from Google Play.</li>
          <li>You use the app for the full 14 days without leaving the test.</li>
          <li>You tell us what works and what doesn’t, with “Send feedback” in the app.</li>
        </ol>
      </section>
    </div>
  </main>
  <Footer />
</BaseLayout>

<script>
  import { initTesterSignupForm } from '../scripts/testerSignupForm.ts'
  initTesterSignupForm()
</script>

<style>
  /* Forest ground, copy on the left, the sign-up page on the right. Colours
     come from braird.css (--bf-*) and the brand tokens; the site pins
     data-theme="light", so the paper page never flips. */
  .tw {
    padding: clamp(104px, 15vh, 148px) 0 clamp(72px, 11vh, 120px);
  }
  .tw-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    grid-template-areas:
      "copy sheet"
      "next sheet";
    grid-template-rows: auto 1fr;
    column-gap: clamp(32px, 6vw, 88px);
    row-gap: 40px;
    align-items: start;
  }
  .tw-copy { grid-area: copy; }
  .tw-sheet { grid-area: sheet; }
  .tw-next { grid-area: next; }

  .tw-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: clamp(34px, 4.6vw, 54px);
    line-height: 1.08;
    letter-spacing: -0.018em;
    color: var(--bf-head);
    margin: 0 0 20px;
    max-width: 16ch;
    text-wrap: balance;
  }
  .tw-lede {
    font-size: clamp(16px, 1.8vw, 18px);
    line-height: 1.55;
    color: var(--bf-muted);
    margin: 0;
    max-width: 44ch;
  }

  /* ── What happens next: a real sequence, so it is numbered ── */
  .tw-next-title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 21px;
    line-height: 1.3;
    color: var(--bf-head);
    margin: 0 0 16px;
  }
  .tw-steps {
    list-style: none;
    counter-reset: tw-step;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 14px;
    max-width: 44ch;
  }
  .tw-steps li {
    counter-increment: tw-step;
    display: grid;
    grid-template-columns: 1.6em 1fr;
    gap: 10px;
    font-size: 15px;
    line-height: 1.5;
    color: var(--bf-paper);
  }
  .tw-steps li::before {
    content: counter(tw-step);
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 20px;
    line-height: 1.15;
    color: var(--bf-leaf);
    text-align: right;
  }

  /* ── The page: paper, a margin rule, labels written in the margin ── */
  .tw-sheet {
    --tw-margin: 10.5rem;
    --tw-gutter: 28px;
    background: var(--color-bg-primary);
    color: var(--color-text-primary);
    border-radius: 6px;
    padding: clamp(28px, 4vw, 44px) clamp(22px, 3.5vw, 44px);
    box-shadow:
      0 1px 0 rgba(255, 255, 255, 0.35) inset,
      0 32px 80px -24px rgba(0, 0, 0, 0.6);
    /* A gap, not `* + *` margins: hidden status/alert and an unrendered
       <noscript> take no space. */
    display: flex;
    flex-direction: column;
    gap: 18px;
  }
  .tw-sheet a {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  /* `.tw-sheet` is flex, `.tw-row` is grid and `.bf-cta` is inline-flex; all outrank the UA [hidden] rule. */
  .tw-sheet [hidden] { display: none !important; }

  .tw-form {
    /* The margin rule: one hairline down the page, between notes and text. */
    background: linear-gradient(color-mix(in srgb, var(--color-accent) 45%, transparent), color-mix(in srgb, var(--color-accent) 45%, transparent)) no-repeat;
    background-size: 1px 100%;
    background-position: calc(var(--tw-margin) + var(--tw-gutter) / 2) 0;
  }
  .tw-row {
    display: grid;
    grid-template-columns: var(--tw-margin) minmax(0, 1fr);
    column-gap: var(--tw-gutter);
    align-items: start;
  }
  /* Rows without a margin note (consent, button) start in the text column. */
  .tw-row > .tw-field:only-child { grid-column: 2; }
  .tw-field > * + * { margin-top: 6px; }

  .tw-label {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 16px;
    line-height: 1.35;
    color: var(--color-text-secondary);
    text-align: right;
    padding-top: 11px; /* centres the first line on a 44px control */
  }
  .tw-label .policy-optional {
    display: block;
    font-size: 13.5px;
  }
  /* The shared muted grey is 3.3:1 on paper; these hints carry instructions. */
  .tw-sheet .policy-hint,
  .tw-sheet .policy-optional { color: var(--color-text-secondary); }

  /* 44px touch targets. */
  .tw-sheet .inp { min-height: 44px; }
  .tw-phones {
    grid-template-columns: repeat(2, max-content);
    column-gap: 28px;
  }
  .tw-phones label { min-height: 44px; align-items: center; }
  .tw-phones input { margin-top: 0; }

  .tw-sheet .inp:focus-visible,
  .tw-sheet .tw-submit:focus-visible {
    outline: 2px solid var(--color-accent-text);
    outline-offset: 2px;
  }
  .tw-submit { margin-top: 4px; }
  .tw-submit:disabled {
    cursor: progress;
    opacity: 0.75;
    transform: none;
    box-shadow: none;
    background: var(--bf-shoot);
  }

  /* Two columns but a narrow sheet: give the text column more of it. */
  @media (min-width: 960px) and (max-width: 1099.98px) {
    .tw-sheet { --tw-margin: 8.5rem; }
  }

  @media (max-width: 959.98px) {
    .tw-grid {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: "copy" "sheet" "next";
      grid-template-rows: auto;
      max-width: 680px;
    }
  }

  /* Narrow: the notes move above their lines, and the rule runs down the left edge. */
  @media (max-width: 599.98px) {
    .tw-form {
      background-position: 0 0;
      padding-left: 18px;
    }
    .tw-row { grid-template-columns: minmax(0, 1fr); row-gap: 4px; }
    .tw-row > .tw-field:only-child { grid-column: 1; }
    .tw-label { text-align: left; padding-top: 0; }
    .tw-label .policy-optional { display: inline; }
  }
</style>
