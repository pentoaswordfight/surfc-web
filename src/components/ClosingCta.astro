---
// Port source: surfc/src/components/LandingPage.jsx lines 389-406.

import { signupUrl } from '../lib/appUrl'
import { TIER_NAMES } from '../lib/tiers'

interface Props {
  /** The button, where a page needs its own (SUR-1204: How it works sends readers to the test sign-up, SUR-1200). */
  cta?: { label: string; href: string; name: string }
}

const { cta = { label: 'Get Marginborn', href: signupUrl(), name: 'closing_signup' } } = Astro.props
---

<section class="hiw-closing-v2">
  <div class="hiw-closing-inner">
    <p class="hiw-step-label hiw-step-center">Take the next step</p>
    <h2 class="hiw-h2 hiw-h2-center">Build your Commonplace</h2>
    <p class="hiw-closing-line">
      So the next time you sit down to write, you're not starting from a blank page.
    </p>
    <p class="hiw-lede-small hiw-center">
      Marginborn is free to use. {TIER_NAMES.pro} is for heavier readers when you're ready.
    </p>
    <div class="hiw-cta-row-v2 hiw-cta-center">
      <a href={cta.href} class="bf-cta" data-cta={cta.name}>
        {cta.label}
      </a>
    </div>
  </div>
</section>
